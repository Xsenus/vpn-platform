# VPN Platform local/CI environment template.
# Copy to .env for local work and replace placeholders only in your private environment.
# Do not commit real Telegram tokens, payment credentials, SSH credentials, or 3x-ui passwords.

# -----------------------------------------------------------------------------
# Compose dependencies
# -----------------------------------------------------------------------------
POSTGRES_DB=vpnplatform
POSTGRES_USER=vpnplatform
POSTGRES_PASSWORD=change-me-local-only
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=vpnplatform;Username=vpnplatform;Password=change-me-local-only
DATABASE_URL=postgres://vpnplatform:change-me-local-only@postgres:5432/vpnplatform
REDIS_CONNECTION=redis:6379
RABBITMQ_CONNECTION=amqp://guest:guest@rabbitmq:5672

# -----------------------------------------------------------------------------
# Backend API / workers common settings
# -----------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
AllowedHosts=*
Jwt__Issuer=VpnPlatform
Jwt__Audience=VpnPlatform.Clients
Jwt__SigningKey=dev-local-signing-key-change-before-production-0001
Security__SecretEncryptionKey=dev-local-secret-encryption-key-change-before-production-0001
Cors__AllowedOrigins__0=http://localhost:5173
Cors__AllowedOrigins__1=http://localhost:5174
Cors__AllowedOrigins__2=http://localhost:5175
Swagger__Enabled=true
DataProtection__KeyPath=../../../tmp/dataprotection-keys
Database__ApplyMigrationsOnStartup=true
Database__Provider=Postgres
Database__UseEnsureCreatedForLocalSqlite=false
Database__SeedDemoData=true

# -----------------------------------------------------------------------------
# Auth lifecycle MVP. Password-reset token return must stay false outside local tests.
# -----------------------------------------------------------------------------
Auth__RefreshTokenDays=30
Auth__PasswordReset__ExpiryMinutes=30
Auth__PasswordReset__ReturnTokenForValidation=false

# -----------------------------------------------------------------------------
# Email delivery. Keep disabled locally; Production startup requires Smtp.
# -----------------------------------------------------------------------------
Email__Mode=Disabled
Email__Host=
Email__Port=587
Email__UseSsl=true
Email__FromAddress=
Email__FromName=VPN Platform
Email__Username=
Email__Password=

# -----------------------------------------------------------------------------
# Safe admin bootstrap. Keep disabled by default. Use only for controlled local/server smoke checks.
# -----------------------------------------------------------------------------
AdminBootstrap__Enabled=false
AdminBootstrap__Email=
AdminBootstrap__Password=
AdminBootstrap__DisplayName=Platform Admin
AdminBootstrap__RolesCsv=SuperAdmin

# -----------------------------------------------------------------------------
# Frontend apps. Vite reads VITE_* at build time.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
VITE_PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_WEB_ORIGIN=http://localhost:5173
CABINET_ORIGIN=http://localhost:5174
ADMIN_PANEL_ORIGIN=http://localhost:5175

# -----------------------------------------------------------------------------
# Payment provider runtime modes. Disabled is the safe default.
# Provider accounts/secrets are managed in the database through admin API/UI.
# Set sandbox/live credentials only outside git.
# -----------------------------------------------------------------------------
Payments__YooMoney__Mode=Disabled
Payments__YooMoney__WebhookSecret=
Payments__YooMoney__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__YooKassa__Mode=Disabled
Payments__YooKassa__WebhookSecret=
Payments__YooKassa__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__RoboKassa__Mode=Disabled
Payments__RoboKassa__WebhookSecret=
Payments__RoboKassa__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__TelegramStars__Mode=Disabled

Payments__CloudPayments__Mode=Disabled
Payments__CloudPayments__WebhookSecret=
Payments__CloudPayments__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__TBankAcquiring__Mode=Disabled
Payments__TBankAcquiring__WebhookSecret=
Payments__TBankAcquiring__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__Prodamus__Mode=Disabled
Payments__Prodamus__WebhookSecret=
Payments__Prodamus__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__Stripe__Mode=Disabled
Payments__Stripe__WebhookSecret=
Payments__Stripe__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

Payments__PayPal__Mode=Disabled
Payments__PayPal__WebhookSecret=
Payments__PayPal__SandboxRedirectBaseUrl=http://localhost:5173/payment-sandbox

# -----------------------------------------------------------------------------
# 3x-ui / x3-ui integration. Sandbox is safe for validation. Leave live panel credentials blank.
# -----------------------------------------------------------------------------
Vpn__X3Ui__Mode=Sandbox
Vpn__X3Ui__SandboxPublicHost=sandbox-node.local
Vpn__X3Ui__SandboxPublicPort=443
X3UI_BASE_URL=
X3UI_USERNAME=
X3UI_PASSWORD=

# -----------------------------------------------------------------------------
# Provisioning. Validation scripts do not connect to live VPS hosts.
# -----------------------------------------------------------------------------
Provisioning__PythonBinary=python3
Provisioning__AnsibleBinary=ansible-playbook
Provisioning__RunnerScriptPath=/opt/vpnplatform/infra/ansible/runner/run_playbook.py
Provisioning__ProvisionPlaybookPath=/opt/vpnplatform/infra/ansible/playbooks/provision-node.yml
Provisioning__PrecheckPlaybookPath=/opt/vpnplatform/infra/ansible/playbooks/precheck-node.yml
Provisioning__WorkingDirectory=/tmp/vpnplatform-provisioning
Provisioning__KnownHostsPath=
Provisioning__ExecutionTimeoutSeconds=3600
Provisioning__LiveExecutionEnabled=false
Provisioning__AllowLiveDeploy=false

# -----------------------------------------------------------------------------
# Telegram bot. Disabled by default so validation never calls Telegram.
# -----------------------------------------------------------------------------
TelegramBot__Enabled=false
TelegramBot__Mode=LongPolling
TelegramBot__BotToken=
TelegramBot__WebhookUrl=
TelegramBot__SecretToken=
TelegramBot__AllowedUpdates__0=message
TelegramBot__AllowedUpdates__1=callback_query
TelegramBot__AllowedUpdates__2=pre_checkout_query
TelegramBot__AdminChatId=
TelegramBot__PublicBotUsername=vpnplatform_bot
TelegramBot__WebAppUrl=http://localhost:5174

{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vpnplatform;Username=vpnplatform;Password=<set-through-env>"
  },
  "Jwt": {
    "Issuer": "VpnPlatform",
    "Audience": "VpnPlatform.Clients",
    "SigningKey": "<set-through-secret-manager-minimum-32-chars>"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://example.com",
      "https://cabinet.example.com",
      "https://admin.example.com"
    ]
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": false,
    "UseEnsureCreatedForLocalSqlite": false,
    "SeedDemoData": false
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "DisplayName": "Platform Admin",
    "RolesCsv": "SuperAdmin",
    "ResetExistingPassword": false
  },
  "Payments": {
    "YooMoney": {
      "WebhookSecret": "<set-through-secret-manager>",
      "Mode": "Production",
      "SandboxRedirectBaseUrl": ""
    },
    "YooKassa": {
      "WebhookSecret": "<set-through-secret-manager>",
      "Mode": "Production",
      "SandboxRedirectBaseUrl": ""
    },
    "RoboKassa": {
      "WebhookSecret": "<set-through-secret-manager>",
      "Mode": "Production",
      "SandboxRedirectBaseUrl": ""
    },
    "TelegramStars": {
      "Mode": "Production"
    },
    "CloudPayments": {
      "Mode": "Production"
    },
    "TBankAcquiring": {
      "Mode": "Production"
    },
    "Prodamus": {
      "Mode": "Production"
    },
    "Stripe": {
      "Mode": "Production"
    },
    "PayPal": {
      "Mode": "Production"
    }
  },
  "Provisioning": {
    "PythonBinary": "python3",
    "AnsibleBinary": "ansible-playbook",
    "RunnerScriptPath": "/opt/vpnplatform/infra/ansible/runner/run_playbook.py",
    "ProvisionPlaybookPath": "/opt/vpnplatform/infra/ansible/playbooks/provision-node.yml",
    "PrecheckPlaybookPath": "/opt/vpnplatform/infra/ansible/playbooks/precheck-node.yml",
    "WorkingDirectory": "/var/lib/vpnplatform/provisioning",
    "KnownHostsPath": "/var/lib/vpnplatform/known_hosts",
    "LiveExecutionEnabled": false,
    "AllowLiveDeploy": false
  },
  "Vpn": {
    "X3Ui": {
      "Mode": "Production",
      "SandboxPublicHost": "",
      "SandboxPublicPort": 443
    }
  },
  "AllowedHosts": "api.example.com",
  "Security": {
    "SecretEncryptionKey": "<set-through-secret-manager-minimum-32-chars>"
  },
  "TelegramBot": {
    "Enabled": false,
    "Mode": "LongPolling",
    "BotToken": "<set-through-secret-manager>",
    "WebhookUrl": "https://api.example.com/api/channels/telegram/webhook",
    "SecretToken": "<set-through-secret-manager>",
    "AllowedUpdates": [
      "message",
      "callback_query",
      "pre_checkout_query"
    ],
    "AdminChatId": null,
    "PublicBotUsername": "<bot-username-without-at>",
    "WebAppUrl": "https://cabinet.example.com"
  },
  "Email": {
    "Mode": "Smtp",
    "Host": "smtp.example.com",
    "Port": 587,
    "UseSsl": true,
    "FromAddress": "no-reply@example.com",
    "FromName": "VPN Platform",
    "Username": "<smtp-username>",
    "Password": "<smtp-password-secret-manager>"
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "PasswordReset": {
      "ExpiryMinutes": 30,
      "ReturnTokenForValidation": false
    }
  }
}

{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=vpnplatform;Username=vpnplatform;Password=local-development-db-password"
  },
  "Jwt": {
    "Issuer": "VpnPlatform",
    "Audience": "VpnPlatform.Clients",
    "SigningKey": "dev-local-signing-key-change-before-production-0001"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Database": {
    "Provider": "Postgres",
    "ApplyMigrationsOnStartup": false,
    "UseEnsureCreatedForLocalSqlite": false,
    "SeedDemoData": false
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Password": "",
    "DisplayName": "Platform Admin",
    "RolesCsv": "SuperAdmin",
    "ResetExistingPassword": false
  },
  "Payments": {
    "YooMoney": {
      "WebhookSecret": "",
      "Mode": "Disabled",
      "SandboxRedirectBaseUrl": "http://localhost:5173/payment-sandbox"
    },
    "YooKassa": {
      "WebhookSecret": "",
      "Mode": "Disabled",
      "SandboxRedirectBaseUrl": "http://localhost:5173/payment-sandbox"
    },
    "RoboKassa": {
      "WebhookSecret": "",
      "Mode": "Disabled",
      "SandboxRedirectBaseUrl": "http://localhost:5173/payment-sandbox"
    },
    "TelegramStars": {
      "Mode": "Disabled"
    },
    "CloudPayments": {
      "Mode": "Disabled"
    },
    "TBankAcquiring": {
      "Mode": "Disabled"
    },
    "Prodamus": {
      "Mode": "Disabled"
    },
    "Stripe": {
      "Mode": "Disabled"
    },
    "PayPal": {
      "Mode": "Disabled"
    }
  },
  "Provisioning": {
    "PythonBinary": "python3",
    "AnsibleBinary": "ansible-playbook",
    "RunnerScriptPath": "../infra/ansible/runner/run_playbook.py",
    "ProvisionPlaybookPath": "../infra/ansible/playbooks/provision-node.yml",
    "PrecheckPlaybookPath": "../infra/ansible/playbooks/precheck-node.yml",
    "WorkingDirectory": "/tmp/vpnplatform-provisioning",
    "KnownHostsPath": "",
    "LiveExecutionEnabled": false,
    "AllowLiveDeploy": false
  },
  "AllowedHosts": "*",
  "Vpn": {
    "X3Ui": {
      "Mode": "Disabled",
      "SandboxPublicHost": "sandbox-node.local",
      "SandboxPublicPort": 443
    }
  },
  "Security": {
    "SecretEncryptionKey": "dev-local-secret-encryption-key-change-before-production-0001"
  },
  "TelegramBot": {
    "Enabled": false,
    "Mode": "LongPolling",
    "BotToken": "",
    "WebhookUrl": "",
    "SecretToken": "",
    "AllowedUpdates": [
      "message",
      "callback_query",
      "pre_checkout_query"
    ],
    "AdminChatId": null,
    "PublicBotUsername": "vpnplatform_bot",
    "WebAppUrl": ""
  },
  "Email": {
    "Mode": "Disabled",
    "Host": "",
    "Port": 587,
    "UseSsl": true,
    "FromAddress": "",
    "FromName": "VPN Platform",
    "Username": "",
    "Password": ""
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "PasswordReset": {
      "ExpiryMinutes": 30,
      "ReturnTokenForValidation": false
    }
  }
}

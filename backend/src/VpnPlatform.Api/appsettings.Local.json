{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=data/vpnplatform-local.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:5175",
      "http://127.0.0.1:5173",
      "http://127.0.0.1:5174",
      "http://127.0.0.1:5175"
    ]
  },
  "Swagger": {
    "Enabled": true
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": true,
    "UseEnsureCreatedForLocalSqlite": true,
    "SeedDemoData": true
  },
  "AdminBootstrap": {
    "Enabled": true,
    "Email": "admin@local.test",
    "Password": "LocalAdminPassword123!",
    "DisplayName": "Локальный администратор",
    "RolesCsv": "SuperAdmin",
    "ResetExistingPassword": true
  },
  "Payments": {
    "YooMoney": {
      "Mode": "Sandbox",
      "WebhookSecret": "local-dev-yoomoney-webhook-secret"
    },
    "YooKassa": {
      "Mode": "Sandbox",
      "WebhookSecret": "local-dev-yookassa-webhook-secret"
    },
    "RoboKassa": {
      "Mode": "Sandbox",
      "WebhookSecret": "local-dev-robokassa-webhook-secret"
    },
    "TelegramStars": {
      "Mode": "Disabled"
    },
    "CloudPayments": {
      "Mode": "Disabled"
    },
    "TBankAcquiring": {
      "Mode": "Disabled"
    },
    "Prodamus": {
      "Mode": "Disabled"
    },
    "Stripe": {
      "Mode": "Disabled"
    },
    "PayPal": {
      "Mode": "Disabled"
    }
  },
  "Vpn": {
    "X3Ui": {
      "Mode": "Sandbox",
      "SandboxPublicHost": "sandbox-node.local",
      "SandboxPublicPort": 443
    }
  },
  "Security": {
    "SecretEncryptionKey": "local-secret-encryption-key-for-sqlite-dev-0001"
  },
  "TelegramBot": {
    "Enabled": false,
    "Mode": "LongPolling",
    "BotToken": "",
    "WebhookUrl": "",
    "SecretToken": "",
    "AllowedUpdates": [
      "message",
      "callback_query",
      "pre_checkout_query"
    ],
    "AdminChatId": null,
    "PublicBotUsername": "vpnplatform_bot",
    "WebAppUrl": "http://localhost:5174"
  },
  "Auth": {
    "RefreshTokenDays": 30,
    "PasswordReset": {
      "ExpiryMinutes": 30,
      "ReturnTokenForValidation": true
    }
  },
  "Provisioning": {
    "LiveExecutionEnabled": false,
    "AllowLiveDeploy": false
  }
}
